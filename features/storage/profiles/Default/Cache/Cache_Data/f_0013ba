                    var value = ($("#searchBy").val()).trim();
                    if(value.length < 3) return false;
                    window.location.href="/admin/indexyii.php?r=products/findProduct&key="+value;
                    // window.open("/admin/indexyii.php?r=products/findProduct&id="+value); 
                }
        });
        });
