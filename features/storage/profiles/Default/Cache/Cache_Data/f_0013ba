$(document).ready(function () {
    $('.hasDatepicker').attr("autocomplete", "off");
            $('#searchInput').on('keyup', function () {
                var searchString = $(this).val();
                liveSearch(searchString);
            });
        });

        function liveSearch(searchString) {
            var http = "http";
            let menuTitle=searchString;
            var resultsContainer = $('#searchResults');
            var serchbox =  $('#searchInput').val();
            let userId = 99;
           var menu = [];
            $.ajax({
	        url: "/admin/?r=Menu/searchmenu&_lang=en",
	        type: "POST",
            async: false,
	        data : {
                'menuTitle' : menuTitle,
                'userId' : userId,
            },
	        success: function (data) {
                var decodedData = JSON.parse(data);
                // console.log(decodedData);
                decodedData.forEach(function (result) {
                    var menuItem = {
                         name: result.menu,
                         url: result.menuURL,
                         subParentmenu: result.subParentmenu,
                         Parentmenu:result.Parentmenu
                     };
                    menu.push(menuItem);
                });
                
                
	        }
		});
            var filteredMenus = menu.filter(function (item) {
             return item.name.toLowerCase().includes(searchString.toLowerCase());
         });

            resultsContainer.empty();
            filteredMenus.forEach(function (filteredMenu) {
                var parent='';
                if(filteredMenu.Parentmenu!=null)
                {
                    parent=filteredMenu.Parentmenu;
                }
                
                var subparent='';
                if(filteredMenu.subParentmenu!=null)
                {
                    subparent=filteredMenu.subParentmenu;
                }

                resultsContainer.append('<li><a href="'+http+'://denim600.primeerp.top.local/admin/indexyii.php?r='+filteredMenu.url+'">'+filteredMenu.name+'</a><br><span style="font-size:10px;color:gray;">'+parent+'--->'+subparent+'</span></li>');
            });

            if(serchbox==='')
            {
                resultsContainer.empty();
            }
        }
        $(document).ready(function(){//umair
            $("#searchBy").keypress(function(evt){
                if(evt.which == 13) {
