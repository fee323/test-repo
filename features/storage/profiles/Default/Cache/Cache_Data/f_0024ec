        <script type="text/javascript">
async function GetDefaultValues() {
    try {
        const response = await fetch('/admin/?r=report/GetDefaultValues&_lang=en');
        
        if (!response.ok) {
            throw new Error(`HTTP error! Status: ${response.status}`);
        }
        const data = await response.json();

        data.forEach(item => {
            let elementId = item.controlId;

            // Adjust control ID for special cases
            if (!item.url.includes("r=report")) {
                elementId = item.controlId.replace('ac_', '').replace('_ac', '');
            }

            const field = $(`#${elementId}`);
            const defaultValue = item.control_defaultValue;

            // Assign values based on field type
            if (field.is(':checkbox')) {
                field.prop('checked', defaultValue === 'checked');
            } else if (field.is(':radio')) {
                $(`input[name='${elementId}'][value='${defaultValue}']`).prop('checked', true);
            } else if (field.is('select')) {
                const selectValue = defaultValue.split('|')[1] || defaultValue;
                field.val(selectValue);
            } else if (field.is('textarea') || field.is('input')) {
                field.val(defaultValue);
            } else {
                console.warn(`Unhandled field type for control ID: ${elementId}`);
            }
        });
    } catch (error) {
        console.error('Error fetching or applying default values:', error);
    }
}

// Call the function
GetDefaultValues();

