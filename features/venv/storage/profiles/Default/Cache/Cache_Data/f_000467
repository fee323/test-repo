// Function for live search
function liveSearch(searchString) {
    var http = "http";
    let menuTitle = searchString;
    var resultsContainer = $('#searchResults');
    var searchbox = $('#searchInput').val();
    let userId = 1;

    if (menu.length === 0) {
        $.ajax({
            url: "/admin/?r=Menu/searchmenu&_lang=en",
            type: "POST",
            async: false, 
            data: {
                'menuTitle': menuTitle,
                'userId': userId,
            },
            success: function (data) {
                var decodedData = JSON.parse(data);
                decodedData.forEach(function (result) {
                    var menuItem = {
                        name: result.menu,
                        url: result.menuURL,
                        subParentmenu: result.subParentmenu,
                        Parentmenu: result.Parentmenu
                    };
                    menu.push(menuItem);
                });
                filterAndDisplayResults(searchString);
            },
            error: function (xhr, status, error) {
                console.error("AJAX request failed: ", status, error);
            }
        });
    } else {
        filterAndDisplayResults(searchString);
    }
    function filterAndDisplayResults(searchString) {
        var filteredMenus = menu.filter(function (item) {
            return item.name.toLowerCase().includes(searchString.toLowerCase());
        });
        resultsContainer.empty();
        filteredMenus.forEach(function (filteredMenu) {
            var parent = filteredMenu.Parentmenu || '';
            var subparent = filteredMenu.subParentmenu || '';

            resultsContainer.append('<li><a href="' + http + '://demo.cartzlink.com.local/admin/indexyii.php?r=' + filteredMenu.url + '">' + filteredMenu.name + '</a><br><span style="font-size:10px;color:gray;">' + parent + '--->' + subparent + '</span></li>');
        });
        if (searchString === '') {
            resultsContainer.empty();
        }
    }
}
